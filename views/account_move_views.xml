<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_debit_note" model="ir.ui.view">
        <field name="name">account.move.form.inherit.debit_note</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="origin_invoice_id" attrs="{'invisible': [('journal_id.name', '!=', 'ND Nota de Débito')]}"/>
            </xpath>
        </field>
    </record>
</odoo>